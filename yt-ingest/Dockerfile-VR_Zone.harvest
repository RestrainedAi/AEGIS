FROM mcr.microsoft.com/playwright/python:v1.58.0-jammy
WORKDIR /app

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        apt-transport-https ca-certificates gnupg curl && \
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
        > /etc/apt/sources.list.d/google-cloud-sdk.list && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends google-cloud-cli && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN playwright install chromium

COPY build_manifest_from_studio_api.py .
COPY download_media_gcs.py .
COPY delta_check_firestore.py .
COPY catalog_sync_firestore_multi.py .
COPY suno_owned_library_snapshot.py .
COPY firestore_upsert.py .
COPY gcp_access_token.py .
COPY enrich_suno_metadata_from_studio_api.py .
COPY backfill_lyrics_artifacts.py .
COPY account_labels.py .
COPY youtube_publish_channels.py .
COPY rebuild_catalog.py .
COPY validate_suno_export_contract.py .
COPY validate_published_catalog_export.py .
COPY fixtures/suno_export_contract_fixture.json fixtures/suno_export_contract_fixture.json
COPY pipeline_monitor.py .
COPY entrypoint.sh .

RUN sed -i 's/\r//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh
RUN mkdir -p /app/logs

ENV WORK_DIR=/app
ENV PROJECT=stable-framing-482501-t9
ENV SUNO_MEDIA_BUCKET=gs://aeonimus-suno-media
ENV WORKSPACES_BUCKET=gs://aeonimus-workspaces
ENV HARVEST_MODE=delta

CMD ["/app/entrypoint.sh"]
