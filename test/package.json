    "test:auth-domain": "node runners/run-feature-suite.mjs auth-domain",
    "test:youtube": "node runners/run-feature-suite.mjs youtube-bridge",
    "test:auth-signup": "node runners/run-feature-suite.mjs auth-signup-tier",
